# Copy to .env (already gitignored) and fill in real values.
# Loaded by python-dotenv in local dev; in Airflow, set these as
# Airflow Variables/Connections instead of relying on a .env file.

ANTHROPIC_API_KEY=sk-ant-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...   # optional — omit to skip Slack, alerts still log
